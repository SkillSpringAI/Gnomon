APP_NAME=research-agent
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://research_agent:research_agent@localhost:5432/research_agent
LLM_PROVIDER=stub
MODEL_ID=local-development
AWS_REGION=us-east-1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_REPORT_CHARS=100000
LLM_MAX_DRAFTS_PER_TASK=20
# Bedrock example for Sydney (enable explicitly; credentials stay outside this file):
# LLM_PROVIDER=bedrock
# MODEL_ID=au.anthropic.claude-sonnet-4-6
# AWS_REGION=ap-southeast-2
# AWS_BEARER_TOKEN_BEDROCK=  # set only in your local shell; do not commit
LLM_API_KEY=
LLM_BASE_URL=
PERSISTENCE_BACKEND=postgres
REQUIRE_TRUSTED_SOURCES=true
